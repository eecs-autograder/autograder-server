FROM python:3.10

RUN apt-get update && apt-get install -y --only-upgrade ca-certificates && rm -rf /var/lib/apt/lists/*
# httplib2 (used by oauth2client) otherwise uses its own outdated CA bundle.
ENV HTTPLIB2_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt

COPY ./requirements.txt .
# requirements.txt pins every package with a hash, so pip rejects any download
# that doesn't match. --no-build-isolation builds source-only packages with the
# image's setuptools instead of downloading unpinned build dependencies.
RUN pip install --require-hashes --no-build-isolation -r requirements.txt

WORKDIR /usr/src/app

COPY . /usr/src/app
RUN mkdir -p media_root
